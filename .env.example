# =============================================================================
# SentinelTrade — .env.example (rascunho)
# -----------------------------------------------------------------------------
# Copie para .env e preencha os valores de verdade NA SUA MÁQUINA.
#   cp .env.example .env
#
# Regras (RNF-SEG-09):
#   - Este arquivo é versionado e NUNCA contém segredo real.
#   - Valores marcados com <TROCAR> são segredos: gere localmente ou pegue no cofre.
#   - Em produção, segredos vêm do cofre (Vault/KMS), não de .env.
#
# Os números de timeout, retentativa e limites seguem as metas propostas em
# requisitos.md e devem ser ajustados nos testes de carga.
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_NAME=sentineltrade
APP_ENV=development                 # development | test | staging | production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo      # horários de pregão e calendário (RF-33)
LOG_LEVEL=info                      # nunca "debug" em produção: pode vazar dados
CORS_ALLOWED_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# Banco de dados transacional (contas, posições, ordens) — RNF-RES-07
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentineltrade
DB_USER=sentinel_app                # usuário SEM permissão de DDL nem de apagar auditoria
DB_PASSWORD=<TROCAR>
DB_SSL_MODE=disable                 # "require" fora de desenvolvimento (RNF-SEG-03)
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=2000


# -----------------------------------------------------------------------------
# Armazenamento da trilha de auditoria — separado do banco principal (RNF-AUD-02)
# -----------------------------------------------------------------------------
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5433
AUDIT_DB_NAME=sentineltrade_audit
AUDIT_DB_USER=sentinel_audit_writer # só INSERT; sem UPDATE/DELETE
AUDIT_DB_PASSWORD=<TROCAR>
AUDIT_HASH_ALGORITHM=SHA-256        # cadeia de hashes (RNF-AUD-01)
AUDIT_RETENTION_YEARS=5


# -----------------------------------------------------------------------------
# Fila de mensagens / outbox — RNF-RES-04
# -----------------------------------------------------------------------------
BROKER_URL=amqp://localhost:5672
BROKER_USER=sentinel
BROKER_PASSWORD=<TROCAR>
QUEUE_ORDERS_OUTBOUND=ordens.enviar
QUEUE_ORDERS_EVENTS=ordens.eventos
QUEUE_NOTIFICATIONS=notificacoes
QUEUE_DEAD_LETTER=ordens.dlq
OUTBOX_POLL_INTERVAL_MS=200


# -----------------------------------------------------------------------------
# Cache (cotações e sessões)
# -----------------------------------------------------------------------------
CACHE_URL=redis://localhost:6379
CACHE_PASSWORD=<TROCAR>


# -----------------------------------------------------------------------------
# Autenticação, sessão e MFA — RF-03, RF-04, RNF-SEG-01/02/08
# -----------------------------------------------------------------------------
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_KB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=1

JWT_ISSUER=sentineltrade
JWT_AUDIENCE=sentineltrade-app
JWT_SIGNING_KEY=<TROCAR>            # ou caminho para a chave: JWT_PRIVATE_KEY_PATH
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min
REFRESH_TOKEN_TTL_SECONDS=86400

MFA_TOTP_ISSUER=Orion Capital (simulado)
MFA_TOTP_DIGITS=6
MFA_TOTP_PERIOD_SECONDS=30
MFA_SECRET_ENCRYPTION_KEY=<TROCAR>  # cifra os segredos TOTP em repouso
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15

ACCOUNT_RECOVERY_COOLDOWN_HOURS=24  # carência sem ordens após recuperação (RF-06)
LOGIN_RATE_LIMIT_PER_MINUTE=10      # RNF-SEG-11


# -----------------------------------------------------------------------------
# Criptografia de dados sensíveis em repouso — RNF-SEG-03, RNF-SEG-12
# -----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=<TROCAR>        # em produção: referência ao KMS, não a chave
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=<TROCAR>


# -----------------------------------------------------------------------------
# Bolsa / corretora simulada — RNF-RES-01..03, RF-21
# -----------------------------------------------------------------------------
EXCHANGE_SIM_URL=http://localhost:9090
EXCHANGE_SIM_API_KEY=<TROCAR>
EXCHANGE_TIMEOUT_MS=2000
EXCHANGE_RETRY_MAX=3                # só para operações idempotentes; ordem nova vai para reconciliação
EXCHANGE_RETRY_BACKOFF_BASE_MS=200
EXCHANGE_RETRY_JITTER=true
RECONCILIATION_INTERVAL_SECONDS=60
RECONCILIATION_MAX_PENDING_MINUTES=5


# -----------------------------------------------------------------------------
# Provedor de cotações simulado — RF-09, RF-10, RNF-DES-02
# -----------------------------------------------------------------------------
QUOTES_PROVIDER_URL=ws://localhost:9091/stream
QUOTES_PROVIDER_API_KEY=<TROCAR>
QUOTES_TIMEOUT_MS=1000
QUOTES_STALE_AFTER_SECONDS=5        # depois disso a cotação é marcada como desatualizada


# -----------------------------------------------------------------------------
# Disjuntor e modo de indisponibilidade segura — RNF-RES-05, RF-32
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_RATE=50     # % de falhas que abre o disjuntor
CIRCUIT_BREAKER_MIN_CALLS=20
CIRCUIT_BREAKER_OPEN_SECONDS=30
SAFE_MODE_AUTO_ENABLE=true
SAFE_MODE_CONTACT_CHANNEL="Mesa de operações: 0800-000-0000 (simulado)"


# -----------------------------------------------------------------------------
# Regras de negócio parametrizáveis — RF-13, RF-14, RF-30, RNF-MAN-01
# -----------------------------------------------------------------------------
IDEMPOTENCY_KEY_TTL_HOURS=24
ORDER_PRICE_DEVIATION_WARN_PCT=10   # confirmação reforçada (RF-13)
ORDER_VALUE_WARN_PCT_OF_EQUITY=30
DEFAULT_MAX_ORDER_VALUE_BRL=50000   # limite padrão até o Analista de risco definir outro
SUITABILITY_VALIDITY_MONTHS=24      # CVM 30


# -----------------------------------------------------------------------------
# Notificações — RF-23, RF-24
# -----------------------------------------------------------------------------
NOTIFY_EMAIL_FROM=nao-responda@orion.example
SMTP_HOST=localhost
SMTP_PORT=1025                      # servidor de teste (ex.: MailHog) em desenvolvimento
SMTP_USER=
SMTP_PASSWORD=<TROCAR>
PUSH_PROVIDER_KEY=<TROCAR>
NOTIFY_MAX_LATENCY_SECONDS=5


# -----------------------------------------------------------------------------
# Observabilidade e rastreabilidade — RNF-RAS-01, RNF-OBS-01
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=sentineltrade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CORRELATION_ID_HEADER=X-Correlation-Id
METRICS_PORT=9464
LOG_MASK_FIELDS=cpf,email,telefone,senha,token,codigoMfa
